{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*", "server/**/*", "shared/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["./shared/*"] }
  }
}
